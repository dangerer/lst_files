<T3DataStructure>
    <sheets>
        <sDEF>
            <ROOT>
                <TCEforms>
                    <sheetTitle>Function</sheetTitle>
                </TCEforms>
                <type>array</type>
                <el>
                    <switchableControllerActions>
                        <TCEforms>
                            <label>Select function</label>
                            <onChange>reload</onChange>
                            <config>
                                <type>select</type>
                                <renderType>selectSingle</renderType>

                                <items>
                                    <numIndex index="0">
                                        <numIndex index="0">Umfrage</numIndex>
                                        <numIndex index="1">Survey->list;Survey->processAnswer;Survey->sendAnswerMail;Survey->sendConfirmation</numIndex>
                                    </numIndex>
                                </items>
                            </config>
                        </TCEforms>
                    </switchableControllerActions>
                </el>
            </ROOT>
        </sDEF>
        <surveyconfiguration>
            <ROOT>
                <TCEforms>
                    <sheetTitle>Konfiguration</sheetTitle>
                </TCEforms>
                <type>array</type>
                <el>
                    <settings.surveyid>
                        <TCEforms>
                            <label>Umfrage</label>
                            <config>
                                <type>select</type>
                                <renderType>selectSingle</renderType>
                                <foreign_table>tx_gtnsurvey_domain_model_survey</foreign_table>
                            </config>
                        </TCEforms>
                    </settings.surveyid>
                    <settings.mailRequired>
                        <TCEforms>
                            <label>Umfrage: Sender-Mail notwendig</label>
                            <config>
                                <type>check</type>
                            </config>
                        </TCEforms>
                    </settings.mailRequired>
                    <settings.receiverMail>
                        <TCEforms>
                            <label>Umfrage: Empfänger-Adresse(n) für Ergebnisse</label>
                            <config>
                                <type>text</type>
                                <cols>24</cols>
                                <rows>5</rows>
                            </config>
                        </TCEforms>
                    </settings.receiverMail>
                </el>
            </ROOT>
        </surveyconfiguration>
    </sheets>
</T3DataStructure>
