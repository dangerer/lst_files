#page.includeJSFooter.ajax_example = EXT:ajax_example/Resources/Public/Scripts/JavaScript/ajax_example.js

gtn_Lst_ajaxPage = PAGE
gtn_Lst_ajaxPage {
    typeNum = 98374812
    config {
        disableAllHeaderCode = 1
        xhtml_cleaning = 0
        admPanel = 0
        additionalHeaders = Content-type: text/plain
        no_cache = 1
        debug = 0
    }

#    20 < tt_content.list.20.gtnlsthooks_ajax
#    10 = TEXT
#    10.value = test
    ###### does not work. WHY????
    10 = USER
    10 {
        userFunc = TYPO3\CMS\Extbase\Core\Bootstrap->run
        extensionName = GtnLsthooks
        pluginName = Ajax
        vendorName = Gtn
        switchableControllerActions {
            Ajax {
                1 = searchRegionsByZip
            }
        }
        controller = Ajax
        action = searchRegionsByZip
        view < plugin.tx_gtnlsthooks_ajax.view
        persistence < plugin.tx_gtnlsthooks_ajax.persistence
        settings < plugin.tx_gtnlsthooks_ajax.settings
    }
}

plugin.tx_news {
    persistence {
        classes {
            GeorgRinger\News\Domain\Model\News {
                subclasses {
                    # three different classes are used for each news type
                    0 = Gtn\GtnLsthooks\Domain\Model\News
                }
            }
            Gtn\GtnLsthooks\Domain\Model\News {
                mapping {
                    recordType = 0
                    tableName = tx_news_domain_model_news
                }
            }
        }
    }
}

