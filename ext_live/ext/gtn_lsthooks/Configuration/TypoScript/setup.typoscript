
page.includeJSFooter {
    file_typohead1 = EXT:gtn_lsthooks/Resources/Public/JavaScripts/bootstrap3-typeahead.min.js
    file_gtnlsthooks1 = EXT:gtn_lsthooks/Resources/Public/JavaScripts/gtn_lsthooks.js
}

plugin.tx_gtnlsthooks_ajax {
    view {
        templateRootPath = EXT:gtn_lsthooks/Resources/Private/Templates/
        partialRootPath = EXT:gtn_lsthooks/Resources/Private/Partials/
        layoutRootPath = EXT:gtn_lsthooks/Resources/Private/Layouts/
    }
    features {
        requireCHashArgumentForActionArguments = 0
    }
    settings {
        adminEmailsToRANapprove = {$ran_empfaenger_international_confirmation}
    }

}

# for using as template generator
plugin.tx_gtnlsthooks < plugin.tx_gtnlsthooks_ajax
#plugin.tx_gtnlsthooks_ajax.mvc.callDefaultActionIfActionCantBeResolved = 1

