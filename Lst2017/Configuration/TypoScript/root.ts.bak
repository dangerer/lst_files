plugin.tx_gtnimpressumlink {
	settings {
#		replaceMarker = ###GTN_IMPRESSUM_LINK###
#		impressumPid = 1331
		# only one word!!
#		linkClass = 
#		linkTarget = _blank
		# only one word!!
#		linkTitle = Datenschutzerklärung
#		linkString = Datenschutzerklärung
		// for many replacers
		replacers {
			1 {
				replaceMarker = Teilnahmebedingungen
				linkToPid = 11646
				# change if you need to have another linked string (if empty - will be used replaceMarker parameter)
				linkString =
				ignoredPages = 11646
				# 0 - no inserting space after result link; 1 - insert space;   I do not think that you need this, but maybe...
				spaceAfter = 0
				# do not use next options if you do not need them really. They can break html
				# search substring can be found in tag attributes. So, complex strings can break such html
				# no any quotes! (" or ')
				# only one word!!
				linkClass =
				linkTarget = _blank
				# only one word!!
				linkTitle =
			}
		}
	}
}

