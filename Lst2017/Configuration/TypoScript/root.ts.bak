# Klasse bodytext vom Text entfernen
lib.parseFunc_RTE.nonTypoTagStdWrap.encapsLines.addAttributes.P >

config {
	disablePrefixComment = 0
	compressBody = 0
}

page.config {
    compressBody = 0
}

plugin {
	tx_news {
		settings {
			facebookLocale = de_DE
			}
	}
}

# Pop-up-Funktion entfernen
tt_content.image.20.1.imageLinkWrap.directImageLink = 1
tt_content.image.20.1.imageLinkWrap.JSwindow = 0

lib.parseFunc_RTE.externalBlocks.table.stdWrap.HTMLparser.tags.table.fixAttrib.class >

tt_content.image.20.1.imageLinkWrap.width = 3000

styles.content.imgtext.linkWrap.width = 500m

# Fluid_styled_content
lib {
	fluidContent {
		templateRootPaths.10 = fileadmin/Lst2017/FluidStyledContent/Resources/Private/Templates/
		partialRootPaths.10 = fileadmin/Lst2017/FluidStyledContent/Resources/Private/Partials/
		layoutRootPaths.10 = fileadmin/Lst2017/FluidStyledContent/Resources/Private/Layouts/
	}
}

lib.contentElement {
   templateRootPaths {
      200 = fileadmin/Lst2017/FluidStyledContent/Resources/Private/Templates/
   }
   partialRootPaths {
      200 = fileadmin/Lst2017/FluidStyledContent/Resources/Private/Partials/
   }
   layoutRootPaths {
      200 = fileadmin/Lst2017/FluidStyledContent/Resources/Private/Layouts/
   }
}


# Cannonical Tag
tmp.canonical = TEXT
tmp.canonical {
	typolink.parameter.data = TSFE:id
	typolink.returnLast = url
	wrap = <link rel="canonical" href="https://test.laborstrauss.com|"  />
}
page.headerData.3750 < tmp.canonical
page.headerData.3750.insertData = 1

config {
	disablePrefixComment = 0
	locale_all = de_DE.UTF-8
	sys_language_uid = 0
	language = de
	linkVars = L(0-2)
	uniqueLinkVars = 1
	defaultGetVars.L = 0
	locale_all = de_DE
	htmlTag_langKey = de
	simulateStaticDocuments = 0
	sys_language_mode = strict
}



	# Deutsche News anzeigen wenn keine Übersetzung
[page["uid"] in [13,88,34,99,43,122,29,265]] AND [siteLanguage("languageId") == 1]
config.sys_language_mode = 
[end]

[siteLanguage("languageId") == 1]
#[Gtn\GtnLstHooks\Condition\FeLanguageSelectedCondition = 1]
	config {
		language = en
		language_alt = en
		locale_all = en_US.UTF-8
		sys_language_uid = 1
		htmlTag_langKey = en
		linkVars = L(int)
		uniqueLinkVars = 1
		htmlTag_setParams = lang="en"
	# Nur die Inhalte in der Standardsprache anzeigen wenn Seite nicht übersetzt ist, das Menü wird dann trotzdem in der richtigen Sprache angezeigt
	# sys_language_mode = content_fallback
}
[end]

# Real Url
config.tx_realurl_enable = 1
config.absRefPrefix = /
# If you link across various domains, you also need this:
# config.typolinkEnableLinksAcrossDomains = 1

config.noPageTitle = 2
page.headerData.1 = TEXT
page.headerData.1.field = title // subtitle
page.headerData.1.wrap = <title>|: Labor Strauss Gruppe</title>

plugin.tx_felogin_pi1 {
    redirectMode = referer
    redirectFirstMethod = GET
}
#config.typolinkLinkAccessRestrictedPages = 38
#config.typolinkLinkAccessRestrictedPages_addParams = &referer=###RETURN_URL###&pageId=###PAGE_ID###

page = PAGE
page {
	shortcutIcon = fileadmin/Lst2017/Resources/Public/Images/favicon.ico
	config {
		htmlTag_langKey = de
		simulateStaticDocuments = 0
		baseURL = https://test.laborstrauss.com/
		tx_realurl_enable = 1
		#removeDefaultJS = 0
		# Emails verschlüsseln
#		sys_language_uid = 0
		language = de
		locale_all = de_DE.UTF-8
		spamProtectEmailAddresses = 6
		spamProtectEmailAddresses_atSubst = <span>&#064;</span>
	}
	
	# body Tag
	bodyTag >
	bodyTagCObject = TEXT
	bodyTagCObject.field = uid
	bodyTagCObject.wrap = <body id="page-|" class="lang-de"> 
	
	
	meta {
		# Description und Keywords aus den Seiten holen
		description {
			data = TSFE:page|description
		}
		keywords {
			# data = TSFE:page|keywords
			value = Brandmeldeanlage, Brandschutz Anlagen, Anlagentechnischer Brandschutz, MEP, LST, Handmelder, Druckknopfmelder, Brandwarnanlage, Brandschutz System, Brandmelder, Wartung Brandmeldeanlage, Löschanlage, Notbeleuchtung, RWA, Errichtung Brandmeldeanlagen, Funkbrandmelder, Alarmanlagen Gewerbe, Vorschriften Brandschutz, Tausch Brandmeldeanlage
			# Bereinigen Leerzeichen weg und Umbruch = Komma
			keywords = 1
		}
		X-UA-Compatible = IE=edge
		X-UA-Compatible.httpEquivalent = 1
		viewport = width=device-width, initial-scale=1
	} 

	
	# RSS Feed in den Header eintragen damit der RSS Feed im Browser angezeigt wird
	headerData {

	
		
		15 = TEXT 
		15.value (
		<script
			  src="https://code.jquery.com/jquery-2.2.4.js"
			  integrity="sha256-iT6Q9iMJYuQiMWNd9lDyBUStIq/8PuOW33aOqmvFpqI="
			  crossorigin="anonymous"></script>
		<!-- <script src="https://code.jquery.com/jquery-migrate-1.2.1.js"></script> -->
			
			

		    <!-- HTML5 shim and Respond.js IE8 support of HTML5 elements and media queries -->
