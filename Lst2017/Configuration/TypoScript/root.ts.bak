page.10.variables.logo {
	10 = TEXT
	10.value (
		<a class="navbar-brand" target="_top" href="https://www.laborstrauss.com/en">
	)
	20 =< lib.logo_en
	30 = TEXT
	30.value = </a>
}

page.10.variables {
	footer_imprint.wrap= ©&nbsp;|&nbsp;Labor Strauss Group
	# Kontakttexte
	locations_header_aut = TEXT
	locations_header_aut.value = Austria
	locations_header_ger = TEXT
	locations_header_ger.value = Germany
	locations_header_int = TEXT
	locations_header_int.value = International Sales
	
	# Variablen Modal Region
	mr_selectregion.value = Select branch
	mr_modalInfo.value = In order to offer our best and quickest service, please select your local LST branch.
	mr_austria.value = Austria
	mr_germany.value = Germany
	mr_international.value = International
	mr_modalInfoZip.value = Alternatively, please enter the postcode of your company.
	mr_modalInfoBranch.value = Find the right branch
	mr_modalInfoZip2.value = To help you quickly find the nearest branch of the Labor Strauss Group, please enter your postcode in Austria or Germany.
	mr_confirm.value = Confirm
	mr_internSales.value = International Sales
	mr_ziplabel.value = Your postcode

	productlist_search.value (
							<form class="form-inline justify-content-end" method="get" action="/">
								<input type="hidden" name="id" value="121" />
								<input type="hidden" name="L" value="1" />
								<label class="sr-only" for="Produktsuche">Produktsuche</label>
								<input class="form-control form-control-lg mr-sm-2" id="Produktsuche" type="text" placeholder="Product Search" name="tx_kesearch_pi1[sword]">
								<button type="submit" class="btn btn-primary btn-lst btn-lstgrey btn-icon btn-icon-lg"><i class="icon ion-ios-search-strong"></i></button>
							</form>
			)
}

[end]


# Standartmeldung leeres Feld
plugin.tx_extbase._LOCAL_LANG.de {
   validator.notempty.empty = Dieses Feld muss ausgefüllt werden!
   validator.emailaddress.notvalid = Diese Mailadresse ist ungültig!
}
# Cache deaktivieren

# config.no_cache = 1
# page.config.no_cache = 1

config.contentObjectExceptionHandler = 0

# Scriptmerger 	
plugin.tx_scriptmerger.javascript.parseBody = 1
plugin.tx_scriptmerger {
	css.minify.ignore = customPrint
	css.compress.ignore = customPrint
	css.merge.ignore = customPrint
}
	


[siteLanguage("languageId") == 1]
#[Gtn\GtnLstHooks\Condition\FeLanguageSelectedCondition = 1]
page.config.language = en
page.config.locale_all = en_US.UTF-8
page.bodyTagCObject.wrap = <body id="page-|" class="lang-en"> 
#plugin.tx_staticinfotables_pi1.settings.languageCode = EN
#plugin.tx_staticinfotables_pi1.languageCode = EN
[end]


