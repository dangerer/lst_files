# settings for lst hooks
# redirect to page by selected region
plugin.lstHooks {
		# disabled. use TS conditions below
		pageRedirectsByRegion {
			# at first - page Id, which must be redirected
			9411111111 {
				# rule:  zoneID  =  shortcut to pid
				# 0 = default
				0 = 75
				# Wien
				9 = 75
				# Graz
				10 = 76
				# Innsbtuck
				11 = 77
				# Mönchengladbach
				12 = 78
				# Hamburg
				13 = 79
				# Pockau-Lengefeld
				14 = 74
				# international
				15 = 80
			}
		}
		pagesForShowSelectRegionModalIfNoRegionSelected = 86,83,67,81,148,32,29
	}


#Wien = 9, Graz = 10, Innsbruck = 11, Mönchengladbach = 12, Hamburg = 13, Pockau = 14, Intern = 15, noRegion = 17
[Gtn\GtnLstHooks\Condition\RegionSelectedCondition = 9]
	
[end]

lib.regionSelectForForms = USER_INT
lib.regionSelectForForms {
	userFunc = GTN\GtnLstHooks\Utils\Utils->showRegionSelectForForm
}

# Powermail allow html in html fields

plugin.tx_powermail.settings.setup.misc.htmlForHtmlFields = 1

plugin.tx_femanager {
        view {
                templateRootPath = fileadmin/Lst2017/Resources/Private/femanager/Templates/
                partialRootPath = fileadmin/Lst2017/Resources/Private/femanager/Partials/
                layoutRootPath = fileadmin/Lst2017/Resources/Private/femanager/Layouts/
        }
}

# for using in Fluid templates
temp.languageTS = TEXT
temp.languageTS.value = de
[siteLanguage("languageId") == 1]
	temp.languageTS.value = en
[end]
lib.languageTS < temp.languageTS
# get current domain in fluid
lib.currentDomainTS = TEXT
lib.currentDomainTS {
    dataWrap = {getIndpEnv:TYPO3_REQUEST_HOST}|
    typolink.parameter.current = 1
    typolink.returnLast = url
}

# Seiten aus der Suche ausschliessen

[225 in tree.rootLineParentIds] OR [336 in tree.rootLineParentIds] OR [388 in tree.rootLineParentIds] OR [389 in tree.rootLineParentIds] OR [390 in tree.rootLineParentIds] OR [391 in tree.rootLineParentIds]
	page.meta.robots = noindex, follow
[end]


