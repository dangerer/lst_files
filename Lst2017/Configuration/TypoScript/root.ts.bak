			<script data-ignore="1" data-cookieconsent="statistics" type="text/plain" data-src="fileadmin/Lst2017/Resources/Public/JavaScript/matomo.js"></script>
		)
			
	}
	
	includeCSS {
		file1 = fileadmin/Lst2017/Resources/Public/bootstrap400/css/bootstrap.min.css
		file3 = fileadmin/Lst2017/Resources/Public/StyleSheets/fonts.css
		file4 = fileadmin/Lst2017/Resources/Public/StyleSheets/flexslider.css
		#file4 = fileadmin/Lst2017/Resources/Public/StyleSheets/font-awesome.min.css
		#file4 = fileadmin/Lst2017/Resources/Public/StyleSheets/glyphicons.css
		file5 = fileadmin/Lst2017/Resources/Public/StyleSheets/ionicons.css
		file8 = fileadmin/Lst2017/Resources/Public/StyleSheets/custom.css
		file9 = fileadmin/Lst2017/Resources/Public/StyleSheets/magnific-popup.css		
		file10 = fileadmin/Lst2017/Resources/Public/StyleSheets/customPrint.css	
		file10.media = print
		# file11 = Landingpage.css
	
	}
	
	# JS Libary im Footer einfügen
	includeJSFooterlibs {
		# file1 = fileadmin/Lst2017/Resources/Public/bootstrap400/js/bootstrap.min.js
		file1 = fileadmin/Lst2017/Resources/Public/JavaScript/popper.js
		file2 = fileadmin/Lst2017/Resources/Public/bootstrap400/js/bootstrap.js
		file3 = fileadmin/Lst2017/Resources/Public/JavaScript/jquery.magnific-popup.js
		file4 = fileadmin/Lst2017/Resources/Public/JavaScript/jquery.rwdImageMaps.min.js
	}
	
	# JS im Footer einfügen
