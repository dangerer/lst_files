			<link rel="apple-touch-icon" sizes="180x180" href="fileadmin/Lst2017/Resources/Public/Images/apple-touch-icon.png" />
			<link rel="icon" type="image/png" sizes="32x32" href="fileadmin/Lst2017/Resources/Public/Images/favicon-32x32.png" />
			<link rel="icon" type="image/png" sizes="16x16" href="fileadmin/Lst2017/Resources/Public/Images/favicon-16x16.png" />
		)
		
		997 = TEXT
