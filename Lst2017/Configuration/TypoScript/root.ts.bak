	10 = FLUIDTEMPLATE
	10 {
		 file.cObject = CASE
		 file.cObject {
		 	key {
		 		# levelfield: -1 = schaut nach ob es einen Eintrag gibt, durch das ,slide wird nachgesehen ob ein Eintrag zu finden ist
		 		data = levelfield: -1 , backend_layout_next_level, slide
		 		# damit wird obriges überschrieben wenn es unter backendlayout einen eintrag gibt überschreibt er data
		 		override.data = TSFE:page|backend_layout
		 		# override.field = backend_layout
		 	}
		 	default = TEXT
			default.value = fileadmin/Lst2017/Resources/Private/Templates/1column.html
		 	
		 	1 = TEXT
		 	1.value = fileadmin/Lst2017/Resources/Private/Templates/Homepage.html
		 	
		 	2 = TEXT
		 	2.value = fileadmin/Lst2017/Resources/Private/Templates/1column.html
		 	
		 	3 = TEXT
		 	3.value = fileadmin/Lst2017/Resources/Private/Templates/productList.html
		 	
		 	4 = TEXT
		 	4.value = fileadmin/Lst2017/Resources/Private/Templates/login.html
		 	
		 	5 = TEXT
		 	5.value = fileadmin/Lst2017/Resources/Private/Templates/Kundenbereich.html
		 	
		 	6 = TEXT
		 	6.value = fileadmin/Lst2017/Resources/Private/Templates/productdetail.html
		 	
		 	7 = TEXT
		 	7.value = fileadmin/Lst2017/Resources/Private/Templates/Kontakt.html
		 	
		 	8 = TEXT
		 	8.value = fileadmin/Lst2017/Resources/Private/Templates/test.html
		 	
		 	10 = TEXT
		 	10.value = fileadmin/Lst2017/Resources/Private/Templates/1columnSubmenu.html
		 	
		 	11 = TEXT
		 	11.value = fileadmin/Lst2017/Resources/Private/Templates/1columnSubmenuKachelnFooter.html
		 	
		 	12 = TEXT
		 	12.value = fileadmin/Lst2017/Resources/Private/Templates/1columnSubmenuFooterLightgrey.html
		 	
		 	14 = TEXT
		 	14.value = fileadmin/Lst2017/Resources/Private/Templates/1columnSubmenuJobFilter.html
		 	
		 	15 = TEXT
		 	15.value = fileadmin/Lst2017/Resources/Private/Templates/1column_survey.html
		 	
		 	16 = TEXT
		 	16.value = fileadmin/Lst2017/Resources/Private/Templates/landingpage.html
		 	
		 	}
	
		
		partialRootPath = fileadmin/Lst2017/Resources/Private/Partials/
		layoutRootPath = fileadmin/Lst2017/Resources/Private/Layouts/
		variables {
			
			
			altlogo = COA
			altlogo {
				10 = TEXT
				10.value (
					<a class="navbar-brand" target="_top" href="https://www.laborstrauss.com">
				)
				20 =< lib.logo
				30 = TEXT
				30.value = </a>
			}
			
			logo = IMAGE
            logo {
                file = fileadmin/Lst2017/Resources/Public/Images/LST-Logo_de.svg
                params=id=brand alt="Komet" title="Labor Strauss Gruppe"
                imageLinkWrap = 1
                imageLinkWrap.enable = 1
                imageLinkWrap.typolink.parameter= https://www.laborstrauss.com
                imageLinkWrap.typolink.ATagParams=class="navbar-brand"
            }
			
			footer_imprint = TEXT
			footer_imprint.data = date:U
			footer_imprint.strftime =%Y
			footer_imprint.wrap= ©&nbsp;|&nbsp;Labor Strauss Gruppe  
			
			navigation_main =< lib.navigation_main
			navigation_service =< lib.navigation_service
			navigation_footer =< lib.navigation_footer
			breadcrumb =< lib.rootline
			navigation_customerarea =< lib.navigation_customerarea
			navigation_locations =< lib.navigation_locations
			navigation_locations_at =< lib.navigation_locations_at
			navigation_locations_de =< lib.navigation_locations_de
			navigation_locations_ww =< lib.navigation_locations_ww
			navigation_submenuLevel2 =< lib.navigation_submenuLevel2
			
			products_tabnav =< lib.tabNavLstProducts
			
			footer_sitemap1 =< lib.footer_sitemap1
			footer_sitemap2 =< lib.footer_sitemap2
			footer_sitemap3 =< lib.footer_sitemap3
			footer_sitemap4 =< lib.footer_sitemap4
			footer_sitemap5 =< lib.footer_sitemap5
			footer_sitemap6 =< lib.footer_sitemap6
			footer_sitemap7 =< lib.footer_sitemap7
			
			productlist_title = TEXT
			productlist_title.data = page : title
			productlist_title.field = nav_title // title
			productlist_title.wrap = <h2 class="prodListHeader">|</h2>
			
			footer_contact < styles.content.get
			footer_contact {
				select.where = colPos = 1
				select.pidInList=45
			}
			
			footer_social < styles.content.get
			footer_social {
				select.where = colPos = 0
				select.pidInList=45
			}
			
			footer_newsl < styles.content.get
			footer_newsl {
				select.where = colPos = 2
				select.pidInList=45
			}
			
			contact_zip = TEXT
			contact_zip.value (
				<div class="card mt-4">
					<div class="card-body">
						<h4 class="card-title">PLZ Suchen</h4>
						<p class="card-text">Anhand Ihrer Postleitzahl können wir feststellen welche Niederlassung für Sie zuständig ist.</p>
						<form class="form-inline">
							<label class="sr-only" for="Produktsuche">Produktsuche</label>
							<input class="form-control mr-sm-2" id="Produktsuche" placeholder="Produktsuche" type="text">
							<button type="submit" class="btn btn-primary btn-lst btn-lstgrey btn-icon"><i class="icon ion-ios-search-strong"></i></button>
						</form>
					</div>
				</div>
			)
			
			productlist_search = TEXT
			productlist_search.value (
							<form class="form-inline justify-content-end" method="get" action="/">
								<input type="hidden" name="id" value="121" />
								<label class="sr-only" for="Produktsuche">Produktsuche</label>
								<input class="form-control form-control-lg mr-sm-2" id="Produktsuche" type="text" placeholder="Produktsuche" name="tx_kesearch_pi1[sword]">
								<button type="submit" class="btn btn-primary btn-lst btn-lstgrey btn-icon btn-icon-lg"><i class="icon ion-ios-search-strong"></i></button>
							</form>
			)
			
			contact_zip >
			
			# Kontakttexte
			locations_header_aut = TEXT
			locations_header_aut.value = Österreich
			locations_header_ger = TEXT
			locations_header_ger.value = Deutschland
			locations_header_int = TEXT
			locations_header_int.value = International
			
			# Pagetitle aus Datenbank auslesen
			#pagetitle = TEXT
			#pagetitle.field = title
			#pagetitle.wrap = <h2>|</h2>

			kesearchbox =< lib.searchbox


			# Kopie von content.get erstellen
			content_0 < styles.content.get
			#content_1 < styles.content.getLeft
			#content_2 < styles.content.getRight
			#content_3 < styles.content.getBorder

			
			content_1 < styles.content.get
			content_1 {
				select.where = colPos = 1
			}
			
			content_2 < styles.content.get
			content_2 {
				select.where = colPos = 2
			}
			
			content_3 < styles.content.get
			content_3 {
				select.where = colPos = 3
			}
			
			content_4 < styles.content.get
			content_4 {
				select.where = colPos = 4
			}
			
			content_5 < styles.content.get
			content_5 {
				select.where = colPos = 5
			}
			
			content_6 < styles.content.get
			content_6 {
				select.where = colPos = 6
			}
			
			content_7 < styles.content.get
			content_7 {
				select.where = colPos = 7
			}
			
			content_8 < styles.content.get
			content_8 {
				select.where = colPos = 8
			}
			
			content_9 < styles.content.get
			content_9 {
				select.where = colPos = 9
			}
			
			content_10 < styles.content.get
			content_10 {
				select.where = colPos = 10
				#renderObj =< lib.FlexSlider
			}
			content_11 < styles.content.get
			content_11 {
				select.where = colPos = 11
			}
			
			# Variablen Modal Region
			mr_selectregion = TEXT
			mr_selectregion.value = Niederlassung wählen
			
			mr_modalInfo = TEXT
			mr_modalInfo.value = Damit wir Sie best- und schnellstmöglich beraten können, wählen Sie bitte die Ihnen bekannte LST-Niederlassung aus.
			
			mr_austria = TEXT
			mr_austria.value = Österreich
			
			mr_germany = TEXT
			mr_germany.value = Deutschland
			
			mr_international = TEXT
			mr_international.value = International
			
			mr_modalInfoZip = TEXT
			mr_modalInfoZip.value = Alternativ geben Sie bitte die Postleitzahl Ihres Unternehmenssitzes ein.
			
			mr_modalInfoBranch = TEXT
			mr_modalInfoBranch.value = Die richtige Niederlassung finden
			
			mr_modalInfoZip2 = TEXT
			mr_modalInfoZip2.value = Damit Sie rasch die nächstgelegene Niederlassung der Labor Strauss Gruppe finden, geben Sie bitte Ihre Postleitzahl an.
			
			mr_confirm = TEXT
			mr_confirm.value = Bestätigen
			
			mr_internSales = TEXT
			mr_internSales.value = Internationaler Verkauf
			
			mr_ziplabel = TEXT
			mr_ziplabel.value = Ihre PLZ
			
			infoPopUp	>

