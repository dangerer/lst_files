

page.config.baseURL = https://test.laborstrauss.com/

page.10.variables {
			logo.10.value (
					<a class="navbar-brand" target="_top" href="https://www.laborstrauss.com">
				)
			}
}

[siteLanguage("languageId") == 1]
#[Gtn\GtnLstHooks\Condition\FeLanguageSelectedCondition = 1]
page.10.variables.logo {
	10.value (
		<a class="navbar-brand" target="_top" href="https://www.laborstrauss.com/en">
	)
}

[end]