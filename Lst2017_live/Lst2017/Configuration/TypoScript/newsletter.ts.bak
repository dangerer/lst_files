     17 = TEXT
    17 {
      value = <table class="csc-textpic csc-textpic-intext-right###CLASSES###"><tr><td valign="top">###TEXT###</td><td valign="top">###IMAGES###</td></tr></table>
      override = <div class="csc-textpic csc-textpic-responsive csc-textpic-intext-left###CLASSES###">###IMAGES######TEXT###</div>
