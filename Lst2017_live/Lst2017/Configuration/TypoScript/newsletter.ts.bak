    26 {
      value = <table class="test csc-textpic-intext-left-nowrap###CLASSES###" cellspacing="0" cellpadding="0" border="0"><tr><td valign="top" class="mso-table-lspace: 0pt;mso-table-rspace: 0pt;-ms-text-size-adjust: 100%;-webkit-text-size-adjust: 100%;">###IMAGES###</td><td valign="top" class="mso-table-lspace: 0pt;mso-table-rspace: 0pt;-ms-text-size-adjust: 100%;-webkit-text-size-adjust: 100%;">###TEXT###</td></tr></table>
      override = <div class="csc-textpic csc-textpic-responsive csc-textpic-intext-left###CLASSES###">###IMAGES######TEXT###</div>
      override {
        if {
          value = default
          equals = {$styles.content.imgtext.layoutKey}
          negate = 1
        }
      }
    }
    
  }
}



