#Wien = 9, Graz = 10, Innsbruck = 11, Mönchengladbach = 12, Hamburg = 13, Pockau = 14, Intern = 15, noRegion = 17

#Wien = 9
[Gtn\GtnLstHooks\Condition\RegionSelectedCondition = 9]
	plugin.tx_powermail.settings.setup.receiver.subject = {$ran_subjectAdmin_wien}
	plugin.tx_powermail.settings.setup.receiver.email = {$ran_empfaenger_wien}
	plugin.tx_powermail.settings.setup.sender.subject = {$ran_subject_wien}
	plugin.tx_powermail.settings.setup.sender.email = {$ran_senderEmail_wien}
	plugin.tx_powermail.settings.setup.sender.name = {$ran_senderName_wien}
	plugin.tx_powermail.settings.setup.receiver.overwrite.senderEmail.value = {$ran_senderEmail_wien}
	plugin.tx_powermail.settings.setup.receiver.overwrite.senderName.value = {$ran_senderName_wien}
[end]

[siteLanguage("languageId") == 1] && [Gtn\GtnLstHooks\Condition\RegionSelectedCondition = 9]
	plugin.tx_powermail.settings.setup.sender.subject = {$ran_subject_EN_wien}
[end]

