
plugin.tx_gtnsurvey_fesurvey {
    view {
        # cat=plugin.tx_gtnsurvey_fesurvey/file; type=string; label=Path to template root (FE)
        templateRootPath = EXT:gtn_survey/Resources/Private/Templates/
        # cat=plugin.tx_gtnsurvey_fesurvey/file; type=string; label=Path to template partials (FE)
        partialRootPath = EXT:gtn_survey/Resources/Private/Partials/
        # cat=plugin.tx_gtnsurvey_fesurvey/file; type=string; label=Path to template layouts (FE)
        layoutRootPath = EXT:gtn_survey/Resources/Private/Layouts/
    }
    persistence {
        # cat=plugin.tx_gtnsurvey_fesurvey//a; type=string; label=Default storage PID
        storagePid =
    }
}

module.tx_gtnsurvey_besurvey {
    view {
        # cat=module.tx_gtnsurvey_besurvey/file; type=string; label=Path to template root (BE)
        templateRootPath = EXT:gtn_survey/Resources/Private/Backend/Templates/
        # cat=module.tx_gtnsurvey_besurvey/file; type=string; label=Path to template partials (BE)
        partialRootPath = EXT:gtn_survey/Resources/Private/Backend/Partials/
        # cat=module.tx_gtnsurvey_besurvey/file; type=string; label=Path to template layouts (BE)
        layoutRootPath = EXT:gtn_survey/Resources/Private/Backend/Layouts/
    }
    persistence {
        # cat=module.tx_gtnsurvey_besurvey//a; type=string; label=Default storage PID
        storagePid =
    }
}
