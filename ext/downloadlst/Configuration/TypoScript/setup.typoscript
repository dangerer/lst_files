
plugin.tx_downloadlst_downloadlst {
    view {
        templateRootPaths.0 = EXT:downloadlst/Resources/Private/Templates/
        templateRootPaths.1 = {$plugin.tx_downloadlst_downloadlst.view.templateRootPath}
        partialRootPaths.0 = EXT:downloadlst/Resources/Private/Partials/
        partialRootPaths.1 = {$plugin.tx_downloadlst_downloadlst.view.partialRootPath}
        layoutRootPaths.0 = EXT:downloadlst/Resources/Private/Layouts/
        layoutRootPaths.1 = {$plugin.tx_downloadlst_downloadlst.view.layoutRootPath}
    }
    persistence {
        storagePid = {$plugin.tx_downloadlst_downloadlst.persistence.storagePid}
        #recursive = 1
    }
    features {
        #skipDefaultArguments = 1
        # if set to 1, the enable fields are ignored in BE context
        ignoreAllEnableFieldsInBe = 0
        # Should be on by default, but can be disabled if all action in the plugin are uncached
        requireCHashArgumentForActionArguments = 1
    }
    settings{
        languageKeys = {$plugin.tx_downloadlst_downloadlst.settings.languageKeys}
        languageIds = {$plugin.tx_downloadlst_downloadlst.settings.languageIds}
        iconFromExt = {$plugin.tx_downloadlst_downloadlst.settings.iconFromExt}
    }
    mvc {
        #callDefaultActionIfActionCantBeResolved = 1
    }
}

# these classes are only used in auto-generated templates
plugin.tx_downloadlst._CSS_DEFAULT_STYLE (
    
)
page.includeCSS.downloadlst_custom = EXT:downloadlst/Resources/Public/css/custom.css
page.includeCSS.downloadlst_treefilter = EXT:downloadlst/Resources/Public/Vendor/treefilter/jquery.treefilter.css
page.includeCSS.downloadlst_ionicons = EXT:downloadlst/Resources/Public/css/ionicons.min.css
page.includeJSFooter.downloadlst_treefilter = EXT:downloadlst/Resources/Public/Vendor/treefilter/jquery.treefilter.js
page.includeJSFooter.downloadlst_custom = EXT:downloadlst/Resources/Public/js/custom.js
config.tx_extbase {
    persistence{
        enableAutomaticCacheClearing = 1

        classes {

            Hafs\Downloadlst\Domain\Model\Extendpages {
                mapping {
                    tableName = pages
                    columns {
                        uid.mapOnProperty = uid
                        pid.mapOnProperty = pid
                        sorting.mapOnProperty = sorting
                        title.mapOnProperty = title
                        subtitle.mapOnProperty = subtitle
                    }
                }
            }

            Hafs\Downloadlst\Domain\Model\Extendttcontent {
                mapping {
                    tableName = tt_content
                    columns {
                        uid.mapOnProperty = uid
                        pid.mapOnProperty = page
                        sorting.mapOnProperty = sorting
                        CType.mapOnProperty = ctype
                        header.mapOnProperty = header
                        header_link.mapOnProperty = headerLink
                        header_layout.mapOnProperty = headerLayout
                        tstamp.mapOnProperty = tstamp

                        bodytext.mapOnProperty = bodytext
                        image.mapOnProperty = image
                        image_link.mapOnProperty = imageLink
                        imagecaption.mapOnProperty = imagecaption
                        colPos.mapOnProperty = colPos
                        categories.mapOnProperty = categories
                        rowDescription.mapOnProperty = rowDescription
                        
                        
                    }
                }
            }
        }
        # make sure ref_index is updated
        updateReferenceIndex = 1
    }
}
